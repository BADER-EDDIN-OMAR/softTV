# Set these in your hosting provider environment. The app does not auto-load .env files.
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Use a unique password of at least 12 characters. Never commit the real password.
# ADMIN_PASSWORD=
# Required for production behind HTTPS:
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true
# Docker Compose only: your public hostname, without scheme or path.
# DOMAIN=requests.your-domain.com
# Only enable behind a trusted proxy that replaces X-Forwarded-For.
# TRUST_PROXY=false
# Optional remote storage for ephemeral/free hosting. Set BOTH or neither.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Remote storage REQUIRES ADMIN_PASSWORD to be set in the hosting environment.
